%% RESULTS_plotter.m  (SCRIPT)
% Plotter de resultados del simulador:
%  - Fuente de datos: logsout (Dataset) si existe, si no -> SDI (último run)
%  - Figura 1: Fuerzas perturbadoras (magnitud): Drag, Solar, Gravedad NO radial
%  - Figura 1b: Fuerza Total ECI (magnitud) como referencia
%  - Figura 2: Momentos (magnitud) + barras max(|M|)
%  - Figura 3: Ground track con sombra vs iluminado (usa x_lineal(:,1:3) en ECI)
%  - Figuras actitud: x_angular = [q0 q1 q2 q3 wx wy wz], scalar-first
%       * (NO se plotean componentes q)
%       * Error real de norma: ||q_raw||-1 (SIN renormalizar)
%       * Euler ZYX (derivados de q normalizado SOLO para geometría)
%       * Rates + norma
%       * Error de apuntamiento a nadir
%
% Requisitos:
%  - Señales con NOMBRES exactos (o case-insensitive) en logsout/SDI.
%  - x_lineal (obligatoria): [rx ry rz vx vy vz] en ECI.
%  - x_angular (opcional): [q0 q1 q2 q3 wx wy wz].
%
% Compatible con MATLAB/Simulink viejos (sin vecnorm, sin string arrays).

clc;
nl = sprintf('\n');

%% =========================
% 0) Parámetros de conversión/convenciones
% =========================
omegaE = 7.2921150e-5; % rad/s (rotación Tierra, para ground track)

% Convención del quaternion:
%   quat_mode = 'CIB' -> q define C_ib (body->inertial): v_I = C_ib * v_B
%   quat_mode = 'CBI' -> q define C_bi (inertial->body): v_B = C_bi * v_I
quat_mode = 'CIB';

% Eje del cuerpo que querés comparar contra nadir (en body frame).
% Si tu satélite apunta con -Z al nadir, poné [0 0 -1].
body_axis_for_nadir = [0 0 1];

% Opcionales (para no romper nada si faltan)
PLOT_DENSITY_COMPARISON = true;   % <- si tu entorno ya lo soporta, ponelo true
PLOT_ORBIT_DIAGNOSTICS  = true;    % <- útil para comparar con GMAT (a,e,i,RAAN,...)

% Constante mu (solo para diagnósticos orbitales)
muEarth = 3.986004418e14; % [m^3/s^2]

%% =========================
% 1) Señales (NOMBRES EXPLÍCITOS)
% =========================
% Mantengo tus nombres actuales (NO tocar):
SIG.F_grav   = 'Fuerza Gravedad';
SIG.M_grav   = 'Momento Gravedad';
SIG.F_drag   = 'Fuerza Drag';
SIG.M_drag   = 'Momento Drag';
SIG.F_solar  = 'Fuerza Solar';
SIG.M_geo    = 'Momento Geomagnético TOTAL';
SIG.F_total  = 'Fuerza Total ECI';
SIG.M_total  = 'Momento Total BODY';
SIG.shadow   = 'shadow';

% Estados (NOMBRES EXPLÍCITOS, sin candidates):
SIG.x_lineal  = 'x_lineal';   % [rx ry rz vx vy vz] en ECI
SIG.x_angular = 'x_angular';  % [q0 q1 q2 q3 wx wy wz] (scalar-first)

% Señales ADICIONALES recomendadas para validación con GMAT (si no existen, no rompen):
% (Si algún nombre no coincide con tu modelo, lo corregís vos.)
SIG.rho        = 'Densidad Atmosférica';        % [kg/m^3] (drag)
SIG.vrel_eci   = 'Velocidad Relativa Atm ECI';  % [m/s] (drag)
SIG.vrel_body  = 'Velocidad Relativa Atm BODY'; % [m/s] (drag)
SIG.Aproj      = 'Area Proyectada Drag';        % [m^2]  (drag)
SIG.CD_eff     = 'CD Efectivo';                 % [-]    (drag)
SIG.cp_body    = 'CP BODY';                     % [m]    (drag torque)
SIG.cg_body    = 'CG BODY';                     % [m]
SIG.sun_eci    = 'Vector Sol ECI';              % [m] o unit vector (SRP)
SIG.B_eci      = 'Campo Geomagnético ECI';      % [T] (geomag)
SIG.a_grav_eci = 'Aceleración Gravedad ECI';    % [m/s^2] (opcional)
SIG.a_total_eci= 'Aceleración Total ECI';       % [m/s^2] (opcional)
SIG.era= 'era';       

% Lista "oficial" de señales a cargar (struct data), manteniendo tus keys actuales y sumando nuevas.
sigKeys = { ...
    'F_grav','M_grav','F_drag','M_drag','F_solar','M_geo','F_total','M_total','shadow', ...
    'r_ecef','v_ecef','rho','vrel_eci','vrel_body','Aproj','CD_eff','cp_body','cg_body','sun_eci','B_eci','a_grav_eci','a_total_eci','era' ...
};

sigNames = { ...
    SIG.F_grav, SIG.M_grav, SIG.F_drag, SIG.M_drag, SIG.F_solar, SIG.M_geo, SIG.F_total, SIG.M_total, SIG.shadow, ...
    SIG.r_ecef, SIG.v_ecef, SIG.rho, SIG.vrel_eci, SIG.vrel_body, SIG.Aproj, SIG.CD_eff, SIG.cp_body, SIG.cg_body, SIG.sun_eci, SIG.B_eci, SIG.a_grav_eci, SIG.a_total_eci,SIG.era ...
};

%% =========================
% 2) Seleccionar fuente: logsout o SDI (SIN heurísticas raras)
% =========================
SRC_MODE = '';
logs = [];

sdiNames = {};
sdiTS    = {};
sdiRunID = [];

% 2.1) Workspace logsout Dataset
if exist('logsout','var') == 1
    try
        if isa(logsout,'Simulink.SimulationData.Dataset') && logsout.numElements > 0
            logs = logsout;
            SRC_MODE = 'workspace.logsout (Dataset)';
        end
    catch
    end
end

% 2.2) SDI (último run)
if isempty(SRC_MODE)
    runIDs = Simulink.sdi.getAllRunIDs;

    if isempty(runIDs)
        error(['No encontré logsout en workspace y tampoco hay runs en SDI.' nl ...
               'No hay datos registrados para graficar.']);
    end

    sdiRunID = runIDs(end);
    r = Simulink.sdi.getRun(sdiRunID);

    try
        ids = r.getSignalIDs;
    catch
        error(['Hay runs en SDI pero no puedo listar señales (getSignalIDs no disponible).' nl ...
               'Abrí el SDI y verificá que las señales estén registradas.']);
    end

    nS = numel(ids);
    sdiNames = cell(nS,1);
    sdiTS    = cell(nS,1);

    for i = 1:nS
        sigObj = [];
        try
            sigObj = Simulink.sdi.getSignal(ids(i));
        catch
            sigObj = [];
        end

        if isempty(sigObj)
            sdiNames{i} = '';
            sdiTS{i} = [];
            continue;
        end

        try
            sdiNames{i} = sigObj.Name;
        catch
            sdiNames{i} = '';
        end

        sdiTS{i} = local_get_sdi_timeseries(sigObj);
    end

    SRC_MODE = sprintf('SDI (último run ID %d)', sdiRunID);
end

fprintf('Fuente de datos: %s\n', SRC_MODE);

%% =========================
% 3) Cargar señales básicas en struct data (MATCH EXACTO / strcmpi)
% =========================
data = struct();

for k = 1:numel(sigKeys)
    key  = sigKeys{k};
    name = sigNames{k};

    data.(key).ok   = false;
    data.(key).name = name;
    data.(key).t    = [];
    data.(key).X    = [];

    ts = [];

    if ~isempty(logs)
        % Dataset: intento directo. Si falla por case, busco strcmpi entre elementos.
        ts = local_get_dataset_timeseries_exact(logs, name);

    else
        % SDI: match exacto / case-insensitive, sin fuzzy.
        ts = local_get_sdi_timeseries_by_name(sdiNames, sdiTS, name);
    end

    if ~isempty(ts)
        try
            [t, X] = local_read_ts(ts);
            data.(key).ok = true;
            data.(key).t  = t;
            data.(key).X  = X;
        catch
            data.(key).ok = false;
        end
    end
end

%% =========================
% 4) Leer x_lineal (OBLIGATORIO): r,v en ECI
% =========================
xTS = [];

if ~isempty(logs)
    xTS = local_get_dataset_timeseries_exact(logs, SIG.x_lineal);
else
    xTS = local_get_sdi_timeseries_by_name(sdiNames, sdiTS, SIG.x_lineal);
end

if isempty(xTS)
    error(['No encontré la señal "' SIG.x_lineal '" en logsout/SDI.' nl ...
           'Asegurate de que esté registrada exactamente con ese nombre.']);
end

[tx, Xstate] = local_read_ts(xTS);
if size(Xstate,2) < 6
    error([SIG.x_lineal ' debe contener al menos 6 estados: r(1:3) y v(4:6).']);
end

rECI = Xstate(:,1:3);
vECI = Xstate(:,4:6);

%% =========================
% 5) Leer x_angular (OPCIONAL): [q0 q1 q2 q3 wx wy wz]
% =========================
xAngTS = [];

if ~isempty(logs)
    xAngTS = local_get_dataset_timeseries_exact(logs, SIG.x_angular);
else
    xAngTS = local_get_sdi_timeseries_by_name(sdiNames, sdiTS, SIG.x_angular);
end

if isempty(xAngTS)
    fprintf(['Aviso: no encontré "' SIG.x_angular '". Se saltean figuras de actitud.' nl]);
    haveAtt = false;
else
    [tA, Xang] = local_read_ts(xAngTS);
    haveAtt = true;

    if size(Xang,2) < 7
        fprintf(['Aviso: "' SIG.x_angular '" tiene menos de 7 componentes. Se saltean figuras de actitud.' nl]);
        haveAtt = false;
    end
end

if haveAtt
    q_raw = Xang(:,1:4);           % [q0 q1 q2 q3] TAL CUAL logueado
    wB    = Xang(:,5:7);           % [wx wy wz]

    % ====== ERROR DE NORMA: sobre q_raw (SIN tocarlo) ======
    qn_raw = sqrt(sum(q_raw.^2,2));
    q_norm_err = qn_raw - 1;

    omega_mag = sqrt(sum(wB.^2,2));

    % ====== Para geometría (Euler/DCM/nadir): continuidad + renormalización SOLO para usar en DCM ======
    q_plot = local_quat_continuity(q_raw); % solo para evitar flips visuales

    n_safe = qn_raw;
    n_safe(n_safe < 1e-12) = 1;
    q_used = q_plot ./ [n_safe n_safe n_safe n_safe];

    % DCM C_ib (body->inertial) según quat_mode
    [c11,c12,c13,c21,c22,c23,c31,c32,c33] = local_quat_to_dcm_cib(q_used, quat_mode);

    % Euler ZYX (yaw, pitch, roll) desde C_ib
    [yaw, pitch, roll] = local_dcm_to_euler_zyx(c11,c21,c31,c32,c33);
    yaw_deg   = local_unwrap_deg(yaw   * 180/pi);
    pitch_deg = local_unwrap_deg(pitch * 180/pi);
    roll_deg  = local_unwrap_deg(roll  * 180/pi);

    % Nadir pointing error (usa q_used)
    axb = body_axis_for_nadir(:);
    axb = axb / max(norm(axb), eps);

    axI_x = c11*axb(1) + c12*axb(2) + c13*axb(3);
    axI_y = c21*axb(1) + c22*axb(2) + c23*axb(3);
    axI_z = c31*axb(1) + c32*axb(2) + c33*axb(3);
    axI = [axI_x axI_y axI_z];

    % Interpolar rECI al tiempo de actitud
    rx = interp1(tx, rECI(:,1), tA, 'linear', 'extrap');
    ry = interp1(tx, rECI(:,2), tA, 'linear', 'extrap');
    rz = interp1(tx, rECI(:,3), tA, 'linear', 'extrap');
    rI = [rx ry rz];
    rnorm = sqrt(sum(rI.^2,2));
    rhat = rI ./ [rnorm rnorm rnorm];

    nadir = -rhat;

    cosang = sum(axI .* nadir, 2);
    cosang = max(min(cosang, 1), -1);
    nadir_err = acos(cosang) * 180/pi;
end

%% =========================
% 6) Derivada: Gravedad NO radial total (perp a r)
% =========================
data.F_grav_nonrad.ok   = false;
data.F_grav_nonrad.name = 'Fuerza Gravedad NO radial (ECI)';
data.F_grav_nonrad.t    = [];
data.F_grav_nonrad.X    = [];

if data.F_grav.ok
    tFg = data.F_grav.t(:);
    Fg  = data.F_grav.X;
    if size(Fg,2) > 3, Fg = Fg(:,1:3); end

    rx = interp1(tx, rECI(:,1), tFg, 'linear', 'extrap');
    ry = interp1(tx, rECI(:,2), tFg, 'linear', 'extrap');
    rz = interp1(tx, rECI(:,3), tFg, 'linear', 'extrap');
    rI = [rx ry rz];

    rnorm = sqrt(sum(rI.^2, 2));
    bad = (rnorm <= 0);
    rnorm(bad) = NaN;

    rhat = rI ./ [rnorm rnorm rnorm];

    Frad_mag = sum(Fg .* rhat, 2);
    F_rad    = rhat .* [Frad_mag Frad_mag Frad_mag];

    F_perp = Fg - F_rad;

    data.F_grav_nonrad.ok = true;
    data.F_grav_nonrad.t  = tFg;
    data.F_grav_nonrad.X  = F_perp;
end

%% =========================
% 7) Sombra: segmentos [tStart tEnd]
% =========================
shadowSegments = [];
if data.shadow.ok
    tt = data.shadow.t(:);
    s  = data.shadow.X(:) > 0.5;

    if numel(tt) == numel(s) && numel(tt) > 1
        ds = diff([false; s; false]);
        i1 = find(ds == 1);
        i2 = find(ds == -1) - 1;
        shadowSegments = [tt(i1) tt(i2)];
    end
end

%% =========================
% 8) FIGURA 1: Fuerzas perturbadoras (magnitud)
% =========================
forceKeys   = {'F_drag','F_solar','F_grav_nonrad'};
forceLabels = {'Drag','Solar','Gravedad NO radial'};

figure('Name','Perturbaciones - Fuerzas (Magnitud)','Color','w');
ax1 = axes; hold(ax1,'on'); grid(ax1,'on');

hF = []; lblF = {};

for i = 1:numel(forceKeys)
    k = forceKeys{i};

    if isfield(data,k) && data.(k).ok
        t = data.(k).t;
        X = data.(k).X;
        if size(X,2) > 3, X = X(:,1:3); end
        mag = sqrt(sum(X.^2,2));

        h = plot(ax1, t, mag, 'LineWidth', 1.4);
        hF(end+1) = h; %#ok<SAGROW>
        lblF{end+1} = forceLabels{i}; %#ok<SAGROW>
    end
end

if isempty(hF)
    text(0.02,0.5,'No hay señales suficientes para fuerzas perturbadoras.','Units','normalized');
else
    xlabel(ax1,'Tiempo [s]');
    ylabel(ax1,'|F| (norma)');
    title(ax1,'Fuerzas perturbadoras (sin gravedad central)');
    local_apply_shadow(ax1, shadowSegments);
    legend(ax1, hF, lblF, 'Location','best');
end

%% =========================
% 8b) FIGURA: Fuerza Total ECI (magnitud) referencia
% =========================
if data.F_total.ok
    figure('Name','Referencia - Fuerza Total ECI (Magnitud)','Color','w');
    ax1b = axes; hold(ax1b,'on'); grid(ax1b,'on');

    t = data.F_total.t;
    X = data.F_total.X;
    if size(X,2) > 3, X = X(:,1:3); end
    mag = sqrt(sum(X.^2,2));
    plot(ax1b, t, mag, 'LineWidth', 1.4);

    xlabel(ax1b,'Tiempo [s]');
    ylabel(ax1b,'|F_total| (norma)');
    title(ax1b,'Fuerza total ECI (solo referencia)');
    local_apply_shadow(ax1b, shadowSegments);
end

%% =========================
% 9) FIGURA 2: Momentos (magnitud) + barras max(|M|)
% =========================
momentKeys   = {'M_grav','M_drag','M_geo','M_total'};
momentLabels = {'Gravedad','Drag','Geomagnético','Total'};

figure('Name','Momentos - Magnitud','Color','w');
ax2 = axes; hold(ax2,'on'); grid(ax2,'on');

hM = []; lblM = {};
maxMom = nan(1,numel(momentKeys));

for i = 1:numel(momentKeys)
    k = momentKeys{i};
    if isfield(data,k) && data.(k).ok
        t = data.(k).t;
        X = data.(k).X;
        if size(X,2) > 3, X = X(:,1:3); end
        mag = sqrt(sum(X.^2,2));

        h = plot(ax2, t, mag, 'LineWidth', 1.4);
        hM(end+1) = h; %#ok<SAGROW>
        lblM{end+1} = momentLabels{i}; %#ok<SAGROW>
        maxMom(i) = max(mag);
    end
end

if isempty(hM)
    text(0.02,0.5,'No hay señales de momento disponibles.','Units','normalized');
else
    xlabel(ax2,'Tiempo [s]');
    ylabel(ax2,'|M| (norma)');
    title(ax2,'Magnitud de momentos');
    local_apply_shadow(ax2, shadowSegments);
    legend(ax2, hM, lblM, 'Location','best');
end

ok = ~isnan(maxMom);
if any(ok)
    vals = maxMom(ok);
    labels = momentLabels(ok);

    figure('Name','Momentos - Máximo por tipo','Color','w');
    ax3 = axes; hold(ax3,'on'); grid(ax3,'on');

    bar(ax3, vals);
    set(ax3,'XTick',1:numel(labels),'XTickLabel',labels);
    ylabel(ax3,'max(|M|)');
    title(ax3,'Momento máximo por tipo');

    if all(vals > 0) && (max(vals)/min(vals) > 50)
        set(ax3,'YScale','log');
    end

    for i = 1:numel(vals)
        text(ax3, i, vals(i), sprintf('  %.3g', vals(i)), ...
            'VerticalAlignment','bottom','Rotation',90);
    end
end

%% =========================
% 10) FIGURA 3: Ground track con sombra vs iluminado (usa rECI)
%    ECEF = C_FIX * R3(ERA) * ECI  (si existe C_FIX y XFORM_MODE==2)
%    Si existe señal 'era', se usa. Si no, se calcula desde jd_ut_inicial.
% =========================
tpos = tx(:);

% --- 10.1 Obtener ERA(t) ---
haveEra = isfield(data,'era') && data.era.ok;

if haveEra
    tEra = data.era.t(:);
    era  = data.era.X;
    era  = era(:); % asegurar vector
    theta = interp1(tEra, era, tpos, 'linear', 'extrap');   % [rad]
else
    if exist('jd_ut_inicial','var') == 1
        % Calcular ERA con tu función (asumo MD_era devuelve rad)
        theta = zeros(size(tpos));
        for i = 1:numel(tpos)
            theta(i) = MD_era(tpos(i), jd_ut_inicial);
        end
    else
        % Fallback bruto: solo rotación uniforme
        theta = omegaE * tpos;
        fprintf('Aviso: no hay señal era ni jd_ut_inicial. Uso theta=omegaE*t (aprox).\n');
    end
end

% --- 10.2 Aplicar R3(theta): r_ECEF_tmp = R3(theta)*r_ECI ---
ct = cos(theta);
st = sin(theta);

xeci = rECI(:,1);
yeci = rECI(:,2);
zeci = rECI(:,3);

xecef = ct.*xeci + st.*yeci;
yecef = -st.*xeci + ct.*yeci;
zecef = zeci;

% --- 10.3 Si estás en modo FIXED_CORR, aplicar C_FIX (constante) ---
useCFIX = false;
if exist('XFORM_MODE','var') == 1 && exist('C_FIX','var') == 1
    try
        xm = XFORM_MODE;
        if isa(xm,'Simulink.Parameter')
            xm_val = double(xm.Value);
        else
            xm_val = double(xm);
        end
        if xm_val == 2
            useCFIX = true;
        end
    catch
        useCFIX = false;
    end
end

if useCFIX
    try
        if isa(C_FIX,'Simulink.Parameter')
            CF = C_FIX.Value;
        else
            CF = C_FIX;
        end
        rtmp = [xecef yecef zecef];          % Nx3
        rfix = rtmp * (CF.');                % Nx3  (equiv. r' = CF*rtmp')
        xecef = rfix(:,1);
        yecef = rfix(:,2);
        zecef = rfix(:,3);
    catch
        fprintf('Aviso: no pude aplicar C_FIX. Continúo con ERA-only.\n');
    end
end

% --- 10.4 Lat/Lon y plot ---
[lat_deg, lon_deg] = local_ecef2lla_wgs84_deg(xecef, yecef, zecef);

lon_deg = mod(lon_deg + 180, 360) - 180;
jump = [false; abs(diff(lon_deg)) > 180];
lat_deg(jump) = NaN;
lon_deg(jump) = NaN;

shadowOn = false(size(tpos));
if data.shadow.ok
    tsh = data.shadow.t(:);
    sh  = data.shadow.X(:) > 0.5;
    if numel(tsh) > 1
        shadowOn = interp1(tsh, double(sh), tpos, 'nearest', 'extrap') > 0.5;
    end
end

lat_sun = lat_deg; lon_sun = lon_deg;
lat_sh  = lat_deg; lon_sh  = lon_deg;
lat_sun(shadowOn) = NaN; lon_sun(shadowOn) = NaN;
lat_sh(~shadowOn) = NaN; lon_sh(~shadowOn) = NaN;

figure('Name','Trayectoria (Ground Track) - Sombra vs Iluminado','Color','w');
ax4 = axes; hold(ax4,'on'); grid(ax4,'on');

didMap = false;
try
    load coastlines
    plot(ax4, coastlon, coastlat, 'LineWidth', 0.8, 'HandleVisibility','off');
    didMap = true;
catch
    try
        load coast
        plot(ax4, long, lat, 'LineWidth', 0.8, 'HandleVisibility','off');
        didMap = true;
    catch
        didMap = false;
    end
end

hSun = plot(ax4, lon_sun, lat_sun, 'LineWidth', 1.6);
hSh  = plot(ax4, lon_sh,  lat_sh,  'LineWidth', 1.6, 'LineStyle','--');

xlabel(ax4,'Longitud [deg]');
ylabel(ax4,'Latitud [deg]');

if didMap
    title(ax4, sprintf('Ground track - pos de %s(:,1:3) en ECI', xNameUsed));
else
    title(ax4, sprintf('Ground track (sin mapa base) - pos de %s(:,1:3) en ECI', xNameUsed));
end

xlim(ax4,[-180 180]);
ylim(ax4,[-90 90]);
legend(ax4, [hSun hSh], {'Iluminado','Sombra'}, 'Location','best');

%% =========================
% 11) FIGURAS DE ACTITUD (si existe x_angular)
% =========================
if haveAtt
    % 11.2 Error real de norma quaternion: ||q_raw|| - 1
    figure('Name','Actitud - Error norma quaternion (REAL)','Color','w');
    axN = axes; hold(axN,'on'); grid(axN,'on');
    plot(axN, tA, q_norm_err, 'LineWidth', 1.4);
    xlabel(axN,'Tiempo [s]');
    ylabel(axN,'||q_{raw}|| - 1');
    title(axN,'Error de normalización del quaternion (sin renormalizar)');
    local_apply_shadow(axN, shadowSegments);

    % 11.3 Euler ZYX (calculados desde q normalizado SOLO para geometría)
    figure('Name','Actitud - Euler ZYX (deg)','Color','w');
    axE = axes; hold(axE,'on'); grid(axE,'on');
    he1 = plot(axE, tA, yaw_deg,   'LineWidth', 1.3);
    he2 = plot(axE, tA, pitch_deg, 'LineWidth', 1.3);
    he3 = plot(axE, tA, roll_deg,  'LineWidth', 1.3);
    xlabel(axE,'Tiempo [s]');
    ylabel(axE,'Ángulo [deg]');
    title(axE, sprintf('Euler ZYX desde q (mode=%s) - q normalizado solo para DCM', quat_mode));
    local_apply_shadow(axE, shadowSegments);
    legend(axE, [he1 he2 he3], {'Yaw \psi','Pitch \theta','Roll \phi'}, 'Location','best');

    % 11.4 Angular rates
    figure('Name','Actitud - Velocidades angulares (rad/s)','Color','w');
    axW = axes; hold(axW,'on'); grid(axW,'on');
    hw1 = plot(axW, tA, wB(:,1), 'LineWidth', 1.2);
    hw2 = plot(axW, tA, wB(:,2), 'LineWidth', 1.2);
    hw3 = plot(axW, tA, wB(:,3), 'LineWidth', 1.2);
    hw4 = plot(axW, tA, omega_mag, 'LineWidth', 1.6);
    xlabel(axW,'Tiempo [s]');
    ylabel(axW,'\omega [rad/s]');
    title(axW,'Rates (body) + norma');
    local_apply_shadow(axW, shadowSegments);
    legend(axW, [hw1 hw2 hw3 hw4], {'\omega_x','\omega_y','\omega_z','|\omega|'}, 'Location','best');

    % 11.5 Nadir pointing error
    figure('Name','Actitud - Error apuntamiento a nadir (deg)','Color','w');
    axP = axes; hold(axP,'on'); grid(axP,'on');
    plot(axP, tA, nadir_err, 'LineWidth', 1.6);
    xlabel(axP,'Tiempo [s]');
    ylabel(axP,'Error [deg]');
    title(axP, sprintf('Error apuntamiento a nadir (axis=[%.0f %.0f %.0f]_B, mode=%s)', ...
        body_axis_for_nadir(1), body_axis_for_nadir(2), body_axis_for_nadir(3), quat_mode));
    local_apply_shadow(axP, shadowSegments);
end

%% =========================
% 12) Diagnósticos orbitales (útil para comparación GMAT)
% =========================
if PLOT_ORBIT_DIAGNOSTICS
    % Elementos orbitales clásicos por muestra (puede ser costoso si hay muchos puntos).
    % Para GMAT la comparación típica es: a,e,i,RAAN,omega,nu o también r,v directamente.
    nT = size(rECI,1);
    a = nan(nT,1); e = nan(nT,1); inc = nan(nT,1);
    raan = nan(nT,1); argp = nan(nT,1); nu = nan(nT,1);

    for ii = 1:nT
        [a(ii), e(ii), inc(ii), raan(ii), argp(ii), nu(ii)] = local_coe_from_rv(rECI(ii,:).', vECI(ii,:).', muEarth);
    end

    figure('Name','Órbita - Elementos clásicos','Color','w');
    axO = axes; hold(axO,'on'); grid(axO,'on');
    plot(axO, tx, a/1e3, 'LineWidth', 1.2);
    xlabel(axO,'Tiempo [s]'); ylabel(axO,'a [km]');
    title(axO,'Semieje mayor');
    local_apply_shadow(axO, shadowSegments);

    figure('Name','Órbita - Excentricidad','Color','w');
    axEcc = axes; hold(axEcc,'on'); grid(axEcc,'on');
    plot(axEcc, tx, e, 'LineWidth', 1.2);
    xlabel(axEcc,'Tiempo [s]'); ylabel(axEcc,'e [-]');
    title(axEcc,'Excentricidad');
    local_apply_shadow(axEcc, shadowSegments);

    figure('Name','Órbita - Inclinación','Color','w');
    axI = axes; hold(axI,'on'); grid(axI,'on');
    plot(axI, tx, inc*180/pi, 'LineWidth', 1.2);
    xlabel(axI,'Tiempo [s]'); ylabel(axI,'i [deg]');
    title(axI,'Inclinación');
    local_apply_shadow(axI, shadowSegments);

    figure('Name','Órbita - RAAN','Color','w');
    axR = axes; hold(axR,'on'); grid(axR,'on');
    plot(axR, tx, local_unwrap_deg(raan*180/pi), 'LineWidth', 1.2);
    xlabel(axR,'Tiempo [s]'); ylabel(axR,'\Omega [deg]');
    title(axR,'RAAN');
    local_apply_shadow(axR, shadowSegments);
end

